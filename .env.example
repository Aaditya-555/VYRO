# Copy to .env locally. Never commit real secrets.
# PostgreSQL connection string for the VYRO API (not a Supabase-specific URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development

# Public HTTPS origin of the deployed VYRO API, used by the Android/web client.
# Set this as a build-time variable when creating a production APK.
VITE_API_BASE_URL=https://api.example.com
